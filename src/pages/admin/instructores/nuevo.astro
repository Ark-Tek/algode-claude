---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import InstructorForm from '../../../components/admin/InstructorForm.astro';
import { writeMarkdownFile, slugify } from '../../../lib/github-cms';

let error = '';

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const rawSlug = String(formData.get('slug') ?? '').trim();
    if (!rawSlug) throw new Error('El slug es obligatorio.');
    const finalSlug = slugify(rawSlug);

    const data = {
      name: String(formData.get('name') ?? '').trim(),
      role: String(formData.get('role') ?? '').trim(),
      company: String(formData.get('company') ?? '').trim(),
      yearsExperience: Number(formData.get('yearsExperience') ?? 0),
      photo: String(formData.get('photo') ?? '').trim() || undefined,
      linkedinUrl: String(formData.get('linkedinUrl') ?? '').trim() || undefined,
      bioShort: String(formData.get('bioShort') ?? '').trim(),
    };
    const body = String(formData.get('body') ?? '').trim();

    await writeMarkdownFile(`src/content/instructors/${finalSlug}.md`, data, body, `Nuevo instructor: ${finalSlug}`);

    return Astro.redirect(`/admin/instructores/${finalSlug}`);
  } catch (e) {
    error = e instanceof Error ? e.message : 'Error desconocido al publicar.';
  }
}
---

<AdminLayout title="Nuevo instructor">
  <h1>Añadir instructor nuevo</h1>

  {error && <div class="error-banner">{error}</div>}

  <div class="admin-card">
    <InstructorForm mode="new" />
  </div>
</AdminLayout>
