---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import CourseForm from '../../../components/admin/CourseForm.astro';
import { writeMarkdownFile, listMarkdownFiles, slugify } from '../../../lib/github-cms';
import { parseCourseForm } from '../../../lib/course-form-parser';

let error = '';

const instructorFiles = await listMarkdownFiles('src/content/instructors').catch(() => []);
const instructors = instructorFiles.map((f) => ({ slug: f.slug, name: f.slug }));

if (Astro.request.method === 'POST') {
  try {
    const formData = await Astro.request.formData();
    const { data, body, slug } = parseCourseForm(formData);
    if (!slug) throw new Error('El título es obligatorio para generar la URL.');
    const finalSlug = slugify(slug);
    await writeMarkdownFile(`src/content/courses/${finalSlug}.md`, data, body, `Nuevo curso: ${finalSlug}`);
    return Astro.redirect(`/admin/cursos/${finalSlug}?creado=1`);
  } catch (e) {
    error = e instanceof Error ? e.message : 'Error desconocido al publicar.';
  }
}
---

<AdminLayout title="Nuevo curso">
  <h1>Nuevo curso</h1>
  <p class="admin-subtitle">Rellena los campos y pulsa "Publicar curso" al final de la página</p>

  {error && (
    <div class="alert alert--error">
      <span class="alert-icon">⚠️</span>
      <div>{error}</div>
    </div>
  )}

  <form method="POST">
    <CourseForm mode="new" instructors={instructors} />
  </form>
</AdminLayout>
