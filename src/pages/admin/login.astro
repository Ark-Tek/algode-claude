---
export const prerender = false;
import { checkPassword, createSessionToken, SESSION_COOKIE_NAME, SESSION_COOKIE_OPTIONS } from '../../lib/auth';

let error = '';

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const password = String(formData.get('password') ?? '');

  try {
    if (checkPassword(password)) {
      const token = createSessionToken();
      Astro.cookies.set(SESSION_COOKIE_NAME, token, SESSION_COOKIE_OPTIONS);
      return Astro.redirect('/admin');
    } else {
      error = 'Contraseña incorrecta.';
    }
  } catch (e) {
    error = e instanceof Error ? e.message : 'Error de configuración del servidor.';
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Acceso — Panel de mantenimiento</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        background: #0F2D4A;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0;
      }
      .login-card {
        background: #fff;
        border-radius: 16px;
        padding: 2rem;
        width: 100%;
        max-width: 360px;
        box-shadow: 0 12px 32px rgba(0,0,0,0.25);
      }
      .login-card h1 { font-size: 1.2rem; margin: 0 0 0.3rem; color: #15212E; }
      .login-card p.sub { font-size: 0.85rem; color: #7C8896; margin: 0 0 1.2rem; }
      label { display: block; font-size: 0.85rem; color: #44515E; margin-bottom: 0.4rem; }
      input[type='password'] {
        width: 100%;
        padding: 0.6rem 0.8rem;
        border-radius: 8px;
        border: 1px solid #CBD5E1;
        font-size: 1rem;
        margin-bottom: 1rem;
        box-sizing: border-box;
      }
      button {
        width: 100%;
        background: #0F2D4A;
        color: #fff;
        border: none;
        border-radius: 8px;
        padding: 0.7rem;
        font-weight: 600;
        font-size: 0.95rem;
        cursor: pointer;
      }
      .error {
        background: #FCEBEB;
        color: #A32D2D;
        padding: 0.6rem 0.8rem;
        border-radius: 8px;
        font-size: 0.85rem;
        margin-bottom: 1rem;
      }
    </style>
  </head>
  <body>
    <div class="login-card">
      <h1>🔒 Panel de mantenimiento</h1>
      <p class="sub">Algode Formación — acceso restringido</p>
      {error && <div class="error">{error}</div>}
      <form method="POST">
        <label for="password">Contraseña</label>
        <input type="password" id="password" name="password" required autofocus />
        <button type="submit">Entrar</button>
      </form>
    </div>
  </body>
</html>
