---
import '../styles/admin.css';

interface Props { title: string }
const { title } = Astro.props;
const currentPath = Astro.url.pathname;
const nav = [
  { href: '/admin',              icon: '🏠', label: 'Inicio' },
  { href: '/admin/cursos',       icon: '📚', label: 'Cursos' },
  { href: '/admin/instructores', icon: '👤', label: 'Instructores' },
  { href: '/admin/blog/nuevo',   icon: '📝', label: 'Nuevo post' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Panel Algode</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="admin-topbar">
      <div class="admin-topbar__brand">🛠️ Algode<span>.</span> Admin</div>
      <div class="admin-topbar__right">
        <a href="/" target="_blank" class="admin-topbar__site">Ver sitio ↗</a>
        <a href="/api/admin/logout" class="admin-topbar__logout">Salir</a>
      </div>
    </header>

    <div class="admin-body">
      <aside class="admin-sidebar">
        <span class="admin-sidebar__section">Contenido</span>
        {nav.map((item) => (
          <a
            href={item.href}
            class:list={['admin-sidebar__link', {
              active: currentPath === item.href ||
                      (item.href !== '/admin' && currentPath.startsWith(item.href))
            }]}
          >
            <span class="admin-sidebar__icon">{item.icon}</span>
            {item.label}
          </a>
        ))}
      </aside>

      <main><slot /></main>
    </div>
  </body>
</html>
