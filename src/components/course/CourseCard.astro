---
import type { CollectionEntry } from 'astro:content';
import Badge from '../ui/Badge.astro';
import { formatCurrency } from '../../utils/format-currency';
import { formatDate } from '../../utils/format-date';
import { getSeatsStatus, getSeatsStatusLabel, getSeatsRemaining } from '../../utils/seats-status';

interface Props { course: CollectionEntry<'courses'> }
const { course } = Astro.props;
const { title, modality, durationHours, level, price, fundaeEligible, hasCertificate, rating, reviewCount, nextSessions, heroImage } = course.data;
const nextSession = nextSessions[0];
const status = nextSession ? getSeatsStatus(nextSession) : null;
---

<a href={`/cursos/${course.id}`} class="course-card" data-modality={modality}>
  <div class="course-card__image">
    {heroImage && <img src={heroImage} alt={`Curso de ${title}`} loading="lazy" width="400" height="220" />}
    <Badge modality={modality} />
    {hasCertificate && <span class="course-card__cert-badge">Certificado</span>}
  </div>
  <div class="course-card__body">
    <h3>{title}</h3>
    <div class="course-card__meta">
      <span>⏱ {durationHours}h</span>
      <span>📊 {level}</span>
      {fundaeEligible && <span>💶 FUNDAE</span>}
    </div>
    {nextSession && status && (
      <p class="course-card__next" data-status={status}>
        {getSeatsStatusLabel(status, getSeatsRemaining(nextSession))} · {formatDate(nextSession.date)}
      </p>
    )}
    <div class="course-card__bottom">
      <span class="course-card__price">{formatCurrency(price)}</span>
      {rating && (
        <span class="course-card__rating">★ {rating} {reviewCount && <span>({reviewCount})</span>}</span>
      )}
    </div>
  </div>
</a>

<style>
  .course-card {
    display: block;
    background: #fff;
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--color-text-primary);
    transition: box-shadow var(--transition-fast), transform var(--transition-fast);
  }
  .course-card:hover { box-shadow: var(--shadow-md); transform: translateY(-2px); text-decoration: none; }

  .course-card__image {
    position: relative;
    height: 110px;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    padding: 0.6rem;
    overflow: hidden;
    background: linear-gradient(135deg, var(--modality-color, var(--color-navy)), color-mix(in srgb, var(--modality-color, var(--color-navy)) 70%, white));
  }
  .course-card__image img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }
  .course-card__image::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.35), transparent 60%);
    z-index: 0;
  }
  .course-card__image :global(.badge),
  .course-card__cert-badge {
    position: relative;
    z-index: 1;
  }
  .course-card__cert-badge {
    font-size: var(--fs-tiny);
    font-weight: 600;
    background: var(--color-amber);
    color: #fff;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
  }

  .course-card__body { padding: var(--space-md); }
  .course-card__body h3 { font-size: var(--fs-small); font-weight: 600; margin: 0 0 0.4rem; line-height: 1.3; }

  .course-card__meta { display: flex; gap: 0.4rem; flex-wrap: wrap; margin-bottom: 0.5rem; }
  .course-card__meta span {
    font-size: var(--fs-tiny);
    background: var(--color-canvas);
    color: var(--color-text-tertiary);
    padding: 0.15rem 0.4rem;
    border-radius: var(--radius-sm);
  }

  .course-card__next {
    font-size: var(--fs-tiny);
    margin: 0 0 0.6rem;
    font-weight: 500;
  }
  .course-card__next[data-status='pocas-plazas'] { color: var(--color-amber); }
  .course-card__next[data-status='disponible'] { color: var(--color-success); }
  .course-card__next[data-status='completo'] { color: var(--color-text-tertiary); }

  .course-card__bottom { display: flex; justify-content: space-between; align-items: center; }
  .course-card__price { font-size: 1.1rem; font-weight: 600; }
  .course-card__rating { font-size: var(--fs-tiny); color: #B26A00; }
  .course-card__rating span { color: var(--color-text-tertiary); }
</style>
