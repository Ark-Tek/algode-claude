---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost';
  size?: 'sm' | 'md';
  class?: string;
}
const { href, variant = 'primary', size = 'md', class: className = '' } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  {...!href && { type: 'button' }}
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    font-family: var(--font-body);
    font-weight: 600;
    border-radius: var(--radius-md);
    border: 0.5px solid transparent;
    text-decoration: none;
    cursor: pointer;
    transition: background var(--transition-fast), border-color var(--transition-fast), transform var(--transition-fast);
    white-space: nowrap;
  }
  .btn:hover { text-decoration: none; }
  .btn:active { transform: translateY(1px); }

  .btn--md { padding: 0.7rem 1.3rem; font-size: var(--fs-small); }
  .btn--sm { padding: 0.45rem 0.9rem; font-size: var(--fs-tiny); }

  .btn--primary {
    background: var(--color-navy);
    color: #fff;
  }
  .btn--primary:hover { background: var(--color-navy-light); }

  .btn--secondary {
    background: transparent;
    color: var(--color-action-blue);
    border-color: var(--color-action-blue);
  }
  .btn--secondary:hover { background: var(--modality-presencial-bg, #EFF6FF); }

  .btn--ghost {
    background: transparent;
    color: var(--color-text-secondary);
    border-color: var(--color-border-strong);
  }
  .btn--ghost:hover { background: var(--color-canvas); }
</style>
