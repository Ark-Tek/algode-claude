---
const items = [
  { href: '/', label: 'Inicio', icon: '🏠' },
  { href: '/cursos', label: 'Cursos', icon: '📚' },
  { href: '/cursos#buscar', label: 'Buscar', icon: '🔍' },
  { href: '/contacto', label: 'Contacto', icon: '👤' },
];
const currentPath = Astro.url.pathname;
---

<nav class="bottom-nav" aria-label="Navegación móvil">
  {items.map((item) => (
    <a href={item.href} class:list={['bottom-nav__item', { 'is-active': currentPath === item.href }]}>
      <span aria-hidden="true">{item.icon}</span>
      <span class="bottom-nav__label">{item.label}</span>
    </a>
  ))}
</nav>

<style>
  .bottom-nav {
    display: none;
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #fff;
    border-top: 0.5px solid var(--color-border);
    z-index: 55;
    padding: 0.3rem 0 0.25rem;
    padding-bottom: max(0.25rem, env(safe-area-inset-bottom));
  }
  .bottom-nav__item {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    color: var(--color-text-tertiary);
    font-size: 1rem;
  }
  .bottom-nav__label { font-size: 9px; color: var(--color-text-tertiary); }
  .bottom-nav__item.is-active { color: var(--color-action-blue); }
  .bottom-nav__item.is-active .bottom-nav__label { color: var(--color-action-blue); font-weight: 600; }
  .bottom-nav__item:hover { text-decoration: none; }

  @media (max-width: 640px) {
    .bottom-nav { display: flex; }
  }
</style>
