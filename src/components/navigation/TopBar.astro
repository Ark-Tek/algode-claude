<div class="topbar">
  <div class="container topbar__inner">
    <span class="topbar__contact">
      <a href="tel:+34900000000">📞 +34 900 000 000</a>
      <span class="topbar__hours">Lun–Vie 9:00–18:00</span>
    </span>
    <span class="topbar__social">
      <a href="https://wa.me/34900000000" target="_blank" rel="noopener noreferrer">WhatsApp</a>
      <a href="mailto:hola@algodeformacion.es">hola@algodeformacion.es</a>
    </span>
  </div>
</div>

<style>
  .topbar {
    background: var(--color-navy);
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--fs-tiny);
  }
  .topbar__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.4rem var(--container-pad);
  }
  .topbar a { color: inherit; opacity: 0.9; }
  .topbar a:hover { opacity: 1; text-decoration: underline; }
  .topbar__contact { display: flex; gap: 0.9rem; align-items: center; }
  .topbar__social { display: flex; gap: 0.9rem; }
  .topbar__hours { opacity: 0.6; }

  @media (max-width: 640px) {
    .topbar__hours, .topbar__social a:last-child { display: none; }
  }
</style>
