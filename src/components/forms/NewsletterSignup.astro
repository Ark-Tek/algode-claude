---
const FORM_ENDPOINT = 'https://formspree.io/f/REPLACE_ME_NEWSLETTER';
---

<form action={FORM_ENDPOINT} method="POST" class="newsletter">
  <input type="email" name="email" placeholder="Tu email" required />
  <button type="submit">Suscribirme</button>
</form>

<style>
  .newsletter { display: flex; gap: 0.5rem; }
  .newsletter input { flex: 1; padding: 0.6rem 0.8rem; border-radius: var(--radius-sm); border: 0.5px solid var(--color-border-strong); }
  .newsletter button { background: var(--color-navy); color: #fff; border: none; border-radius: var(--radius-sm); padding: 0.6rem 1.1rem; font-weight: 600; }
</style>
