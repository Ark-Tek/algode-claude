---
// Quiz "Encuentra tu curso" — 4 preguntas, resultado con match score.
// La lógica de matching vive en src/scripts/quiz-logic.js
---

<section class="quiz" id="quiz">
  <div class="quiz__header">
    <h2>🎯 Encuentra tu curso ideal</h2>
    <p>4 preguntas · menos de 1 minuto · sin registro</p>
  </div>

  <div class="quiz__card" id="quiz-question-card">
    <div class="quiz__progress"><div class="quiz__progress-fill" id="quiz-progress-fill"></div></div>
    <p class="quiz__step-label" id="quiz-step-label">Pregunta 1 de 4</p>
    <p class="quiz__question" id="quiz-question-text"></p>
    <div class="quiz__options" id="quiz-options"></div>
    <div class="quiz__nav">
      <button type="button" id="quiz-back" class="quiz__back-btn" hidden>← Atrás</button>
      <div class="quiz__dots" id="quiz-dots"></div>
      <button type="button" id="quiz-next" class="quiz__next-btn" disabled>Siguiente →</button>
    </div>
  </div>

  <div class="quiz__result" id="quiz-result" hidden>
    <div class="quiz__result-top">
      <div>
        <h3 id="quiz-result-title"></h3>
        <p id="quiz-result-sub"></p>
      </div>
      <div class="quiz__match"><span id="quiz-result-match"></span><small>coincidencia</small></div>
    </div>
    <div class="quiz__result-ctas">
      <a href="#" id="quiz-result-cta" class="quiz__btn-primary">Ver curso →</a>
      <button type="button" id="quiz-reset" class="quiz__btn-secondary">Volver a empezar</button>
    </div>
  </div>
</section>

<script src="../../scripts/quiz-logic.js"></script>

<style>
  .quiz { padding: var(--space-2xl) 0; max-width: 560px; margin: 0 auto; }
  .quiz__header { text-align: center; margin-bottom: var(--space-lg); }
  .quiz__header p { color: var(--color-text-tertiary); font-size: var(--fs-small); }

  .quiz__card, .quiz__result {
    background: #fff;
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    box-shadow: var(--shadow-sm);
  }

  .quiz__progress { background: var(--color-border); border-radius: var(--radius-pill); height: 5px; margin-bottom: 6px; }
  .quiz__progress-fill { height: 5px; border-radius: var(--radius-pill); background: linear-gradient(90deg, var(--color-action-blue), var(--color-teal)); transition: width 0.3s; }
  .quiz__step-label { font-size: var(--fs-tiny); color: var(--color-text-tertiary); text-align: right; margin: 0 0 var(--space-md); }
  .quiz__question { font-size: 1.05rem; font-weight: 600; margin-bottom: var(--space-md); }

  .quiz__options { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .quiz__option {
    border: 0.5px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    padding: 0.7rem;
    background: #fff;
    text-align: left;
    cursor: pointer;
    font-size: var(--fs-small);
  }
  .quiz__option.is-selected, .quiz__option:hover { border-color: var(--color-action-blue); background: #EFF6FF; }
  .quiz__option strong { display: block; margin-bottom: 0.1rem; }
  .quiz__option span { color: var(--color-text-tertiary); font-size: var(--fs-tiny); }

  .quiz__nav { display: flex; justify-content: space-between; align-items: center; margin-top: var(--space-md); }
  .quiz__back-btn { background: none; border: 0.5px solid var(--color-border-strong); border-radius: var(--radius-sm); padding: 0.4rem 0.8rem; font-size: var(--fs-small); cursor: pointer; }
  .quiz__next-btn { background: var(--color-navy); color: #fff; border: none; border-radius: var(--radius-sm); padding: 0.5rem 1.1rem; font-size: var(--fs-small); font-weight: 600; cursor: pointer; }
  .quiz__next-btn:disabled { background: var(--color-border-strong); cursor: not-allowed; }
  .quiz__dots { display: flex; gap: 4px; }
  .quiz__dot { width: 6px; height: 6px; border-radius: 50%; background: var(--color-border-strong); }
  .quiz__dot.is-active { background: var(--color-action-blue); width: 14px; border-radius: var(--radius-pill); }
  .quiz__dot.is-done { background: var(--color-teal); }

  .quiz__result-top { display: flex; justify-content: space-between; gap: var(--space-md); margin-bottom: var(--space-md); }
  .quiz__match { background: var(--color-success-bg); border-radius: var(--radius-md); padding: 0.5rem 0.8rem; text-align: center; flex-shrink: 0; }
  .quiz__match span { display: block; font-size: 1.2rem; font-weight: 700; color: var(--color-success); }
  .quiz__match small { font-size: var(--fs-tiny); color: var(--color-success); }
  .quiz__result-ctas { display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; }
  .quiz__btn-primary { background: var(--color-navy); color: #fff; text-align: center; padding: 0.6rem; border-radius: var(--radius-sm); font-weight: 600; font-size: var(--fs-small); }
  .quiz__btn-primary:hover { text-decoration: none; }
  .quiz__btn-secondary { background: none; border: 0.5px solid var(--color-action-blue); color: var(--color-action-blue); border-radius: var(--radius-sm); font-size: var(--fs-small); cursor: pointer; }
</style>
